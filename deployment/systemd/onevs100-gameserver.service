[Unit]
Description=1 vs 100 revival gameserver
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/onevs100/gameserver.env
# data/ and logs/ resolve relative to the state directory.
StateDirectory=onevs100
WorkingDirectory=/var/lib/onevs100
ExecStart=/opt/onevs100/onevs100-gameserver
Restart=on-failure
RestartSec=3
# Ports 80, 123 and 1000 are privileged.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
