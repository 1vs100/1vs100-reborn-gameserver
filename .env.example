# Copy to `.env` (compose, manual) or /etc/onevs100/gameserver.env (systemd) and adjust.
# One setting per line, values unquoted, comments on their own lines.

# Required
# IP of this host on the network the console uses. Must be a concrete address,
# not 0.0.0.0: it is also handed to the console as the server's address.
GAMESERVER_BIND=192.0.2.10
# IP the game ports bind to, when it is not GAMESERVER_BIND: a container binds its own address
# while the host publishes the ports on GAMESERVER_BIND. Unset: GAMESERVER_BIND.
# GAMESERVER_LISTEN_IP=

# Title build this instance serves: 1149 (retail v2.0.1149.0) or 1317 (v2.0.1317.0).
# Picks the listening ports and the SBG/Grid protocol; run one instance per build.
#   1149: TCP 80 (GRID), 1000 (SBG), 1001 (MM), 1002 (MADS); UDP 1123 (NTP)
#   1317: TCP 80 (GRID), 1000 (SBG), 1001 (MM), 1002 (MADS); UDP 123 (NTP)
GAMESERVER_PROTOCOL=1317

# Grid / livehost HTTP
# ip:port the Grid and livehost HTTP service listens on. Unset: port 80 of GAMESERVER_LISTEN_IP.
# The console always dials GAMESERVER_BIND:80. The host's nginx forwards from there to the
# stack's nginx (GAMESERVER_SITE_LISTEN), which forwards to this address. Both keep the Host
# header unchanged: the Grid signs its replies over it.
GAMESERVER_HTTP_ADDR=127.0.0.1:8090

# Admin API / web UI
# Unauthenticated API (clears keys, steers the game): keep it on loopback or a trusted network.
GAMESERVER_ADMIN_ADDR=127.0.0.1:8081
# Where nginx serves the admin UI; it proxies /admin to GAMESERVER_ADMIN_ADDR.
GAMESERVER_UI_LISTEN=127.0.0.1:8080

# Public status API
# Read-only status (/status/v1/...) for a public site: no XUIDs or addresses, and only players
# whose in-game privacy setting is public are named. A reverse proxy publishes it.
# GAMESERVER_STATUS_ADDR=127.0.0.1:8082
# Where the stack's nginx serves the public site and forwards the consoles' Grid requests to
# GAMESERVER_HTTP_ADDR. The host's nginx forwards GAMESERVER_BIND:80 here.
# GAMESERVER_SITE_LISTEN=127.0.0.1:8083

# Storage and logs
# SQLite directory; the value `memory` keeps everything in RAM.
GAMESERVER_DATA_DIR=data
# PostgreSQL connection string, such as postgres://user:password@host/database. When set, it is
# used instead of GAMESERVER_DATA_DIR. Docker Compose sets it to the stack's own database and
# ignores this value.
# GAMESERVER_DATABASE_URL=
GAMESERVER_LOG_DIR=logs
# tracing filter
GAMESERVER_LOG=info

# Simulation and flow (defaults shown)
# 1/0 switches
# GAMESERVER_SYNTHETIC_MOB=1
# GAMESERVER_SERVER_FLOW=1
# Simulated crowd members, 0 = none
# GAMESERVER_SYNTHETIC_CROWD=60

# Daily programme (first start only: then the admin page's saved one)
# Primetime every day at these local times (e.g. 19:00,22:00), Extended Play between them
# GAMESERVER_PROGRAMME_ZONE=America/New_York
# GAMESERVER_PRIMETIME_AT=20:00
# GAMESERVER_PRIMETIME_MINUTES=60
# Extended Play show length: one episode, at most 30
# GAMESERVER_EXTENDED_PLAY_MINUTES=30
# Minutes before a Primetime show's end that rounds stop (served in the title's Config)
# GAMESERVER_PT_MIN_END_MINUTES=5

# Matchmaking groups
# Players per group (1-4, local players included) and how long a console that left keeps its
# place in its group
# GAMESERVER_GROUP_SIZE=4
# GAMESERVER_GROUP_GRACE_SECS=30

# Content ids (marketplace package ids in the Grid sessions XML)
# GAMESERVER_LAUNCH_CONTENT_ID=988237803712CB87513237A914D367C6AAEE2410
# GAMESERVER_SHOW_CONTENT_ID=77205BC1241C708A8A10B7303AF90E5EDD0286B1
# GAMESERVER_EPISODE_CONTENT_ID=83136FF343124795DC1806A2DB044476589BD5C0

# Debugging
# Directory to write every posted GameState document to
# GAMESERVER_DUMP_GAMESTATE=
# File to record every SBG frame in and out to from startup on, with time and caller
# (replay: sbg::replay). The admin SBG tab starts and stops recordings while the server runs.
# GAMESERVER_RECORD_SBG=

# Ads
# massived configuration file (mads_server_v5) to serve Massive ads with, served on the ads
# port. Unset: no ad content.
# GAMESERVER_ADS_CONFIG=
# Host name consoles reach this server by, told to the ad client for its later requests and
# downloads. Unset: GAMESERVER_BIND.
# GAMESERVER_PUBLIC_HOST=

# Live host
# ASF file of WMA audio with fixed-size packets served as the live host stream; the title plays
# it from the start for each live host segment. scripts/generate_livehost_audio.sh writes one.
# Unset: the built-in 2 minute test stream.
# GAMESERVER_LIVEHOST_FILE=
